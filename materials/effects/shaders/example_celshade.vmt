screenspace_general
{
	// Shader Model 3.0, built with shadersrc/build_celshade.bat
	$pixshader    "example_celshade_ps30"
	// vertex shader shipped with the GShader library
	$vertexshader "pp_vs30"

	// requires the GShader library (Garry's Mod) with r_shaderlib 1
	$basetexture "_rt_FullFrameFB"
	$texture1    "_rt_NormalsTangents"
	$texture2    "_rt_WPDepth"
	// _rt_Lightmaps is assigned from Lua, as it only exists with newer GShader versions
	$texture3    ""

	$vertextransform 1
	$ignorez         1
	"<dx90"
	{
		$no_draw 1
	}

	$copyalpha                 1
	$alpha_blend_color_overlay 0
	$alpha_blend               0
	$linearwrite               0
	$linearread_basetexture    0
	$linearread_texture1       0
	$linearread_texture2       0
	$linearread_texture3       0

	// bands, band softness, saturation, shadow detail threshold
	$c0_x     4.0
	$c0_y     0.05
	$c0_z     1.05
	$c0_w     0.1
	// outline thickness (px), depth threshold, normal threshold, outline opacity
	$c1_x     1.0
	$c1_y     0.02
	$c1_z     0.4
	$c1_w     1.0
	// outline color, outline fade distance
	$c2_x     0.05
	$c2_y     0.03
	$c2_z     0.03
	$c2_w     3000.0
	// lighting bands (0 = off), shadow brightness, lightmap scale (set from Lua), lighting threshold
	$c3_x     1.0
	$c3_y     0.45
	$c3_z     4.59479
	$c3_w     0.6
}
